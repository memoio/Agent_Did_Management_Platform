{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memo.example/schemas/agent-did-deployment-v1.json",
  "type": "object",
  "required": [
    "schema", "environment", "networkName", "chainId", "publicRpcUrl", "nativeCurrency",
    "entryPoint", "simpleAccountFactory", "relayerSmartAccount", "didRegistry",
    "managementRegistry", "finality", "generatedAt"
  ],
  "properties": {
    "schema": { "const": "memo.agent-did-deployment/1" },
    "environment": { "enum": ["local", "preprod", "production"] },
    "chainId": { "const": 985 },
    "entryPoint": {
      "type": "object",
      "required": ["address", "version", "runtimeCodeHash"],
      "properties": {
        "address": { "const": "0x0000000071727De22E5E9d8BAf0edAc6f37da032" },
        "version": { "const": "0.7" },
        "runtimeCodeHash": { "const": "0x8db5ff695839d655407cc8490bb7a5d82337a86a6b39c3f0258aa6c3b582fc58" }
      }
    },
    "relayerSmartAccount": {
      "type": "object",
      "required": ["address", "ownerAddress", "ownerProvider", "runtimeCodeHash"],
      "properties": {
        "address": { "pattern": "^0x[0-9a-fA-F]{40}$" },
        "ownerAddress": { "pattern": "^0x[0-9a-fA-F]{40}$" },
        "ownerProvider": { "enum": ["dev-private-key", "kms", "hsm"] },
        "runtimeCodeHash": { "pattern": "^0x[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
