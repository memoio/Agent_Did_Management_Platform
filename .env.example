NODE_ENV=development
HOST=127.0.0.1
PORT=4273
# Set to true only behind a trusted reverse proxy when binding a public interface.
MEMO_BEHIND_TRUSTED_PROXY=false

# Public opBNB Testnet connection information for platform integration.
# The API and Worker read these values at runtime; this file is only a template.
MEMO_CHAIN_ID=5611
MEMO_NETWORK_NAME=opBNB Testnet
MEMO_PRIMARY_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
MEMO_SECONDARY_RPC_URL=https://opbnb-testnet-rpc.publicnode.com
MEMO_EXPLORER_URL=https://opbnb-testnet.bscscan.com
MEMO_NATIVE_CURRENCY_SYMBOL=tBNB
MEMO_NATIVE_CURRENCY_DECIMALS=18
MEMO_GENESIS_HASH=0x51fa57729dfb1c27542c21b06cb72a0459c57440ceb43a465dae1307cd04fe80
MEMO_RELAYER_ADDRESS=0xd511f5C8A3e0A12f6119aCA7463d6f619CEf14B0
MEMO_RELAYER_PRIVATE_KEY=

# Existing Memo EAS deployment on opBNB Testnet.
