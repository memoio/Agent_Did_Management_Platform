NODE_ENV=development
HOST=127.0.0.1
PORT=4273
# Set to true only behind a trusted reverse proxy when binding a public interface.
MEMO_BEHIND_TRUSTED_PROXY=false

# Chain module configuration: load explicitly via shell or node --env-file.
MEMO_PRIMARY_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
MEMO_SECONDARY_RPC_URL=https://opbnb-testnet-rpc.publicnode.com
MEMO_CHAIN_MANIFEST_PATH=
MEMO_CHAIN_MANIFEST_SHA256=
# Write access is explicit. All amounts below are integer wei strings.


# Dedicated Agent platform TESTNET gas payer.
# Inject the private key securely on the server, never commit a value.
# Use either this key or MEMO_SIGNER_MODULE_PATH.

MEMO_SUBMISSION_DIRECTORY=
MEMO_MINIMUM_BALANCE_WEI=
MEMO_ALLOW_FINALITY_FALLBACK=false
MEMO_DEPLOYMENT_ID=

# Absolute directory outside this repository; contains signed transaction checkpoints.
MEMO_DEPLOYMENT_DIR=
# External module exporting createSigner({provider,keyId}); credentials stay in KMS.
MEMO_SIGNER_MODULE_PATH=
MEMO_RELAYER_SIGNER_KEY_ID=
# Platform/operations must choose these; there are no write-enabled defaults.
MEMO_FINALITY_MODE=
MEMO_FALLBACK_CONFIRMATIONS=
MEMO_MAX_REORG_DEPTH=
MEMO_GAS_PRICE_CAP_WEI=
MEMO_GAS_LIMIT_CAP=
MEMO_RELAYER_ADDRESS=0xd511f5C8A3e0A12f6119aCA7463d6f619CEf14B0
MEMO_DEPLOYER_ADDRESS=0xd511f5C8A3e0A12f6119aCA7463d6f619CEf14B0
MEMO_RELAYER_PRIVATE_KEY=0x409952dc0932f547f2ca7656533ffba462c3cd3b457c1b02e2da305208f7437e
MEMO_CHAIN_WRITES_ENABLED=false
