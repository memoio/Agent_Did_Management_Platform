MEMO_SCHEMA_SERVICE_UID=0xef402073ca44dcc56dd1b5d7beb8f9da32a4ded363367d1a4734099c7a0c6a20

# Agent-specific deployment details: fill from the actual deployment record.
MEMO_DID_REGISTRY_ADDRESS=
MEMO_MANAGEMENT_REGISTRY_ADDRESS=
MEMO_CHAIN_MANIFEST_PATH=
MEMO_CHAIN_MANIFEST_SHA256=
