NODE_ENV=development
MEMO_ENVIRONMENT=local
PORT=4273
WORKER_POLL_MS=500
MEMO_CHAIN_ID=985
MEMO_NETWORK_NAME=MEMO Mainnet Local
MEMO_NATIVE_CURRENCY_NAME=MEMO
MEMO_NATIVE_CURRENCY_SYMBOL=MEMO
MEMO_NATIVE_CURRENCY_DECIMALS=18
MEMO_PRIMARY_RPC_URL=http://127.0.0.1:9545
MEMO_SECONDARY_RPC_URL=http://127.0.0.1:9545
MEMO_BUNDLER_URL=http://127.0.0.1:4337
MEMO_PUBLIC_RPC_URL=http://127.0.0.1:9545
MEMO_PUBLIC_WSS_URL=
# preprod/production require two different HTTPS RPC endpoints, HTTPS Bundler,
# a wss:// public endpoint, and confirmed currency metadata.
MEMO_PLATFORM_ORIGINS=https://agent-did.example.com
MEMO_REQUIRED_CONFIRMATIONS=2
MEMO_FINALITY_MODE=confirmations
MEMO_DEPLOYMENT_MANIFEST=deploy/local/985.json
MEMO_DATA_ROOT=.data/local
MEMO_SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
MEMO_RELAYER_OWNER_PROVIDER=dev-private-key
MEMO_RELAYER_OWNER_PRIVATE_KEY=
MEMO_RELAYER_OWNER_ADDRESS=
MEMO_RELAYER_SIGNER_ENDPOINT=
MEMO_RELAYER_SIGNER_KEY_ID=
# Deliver through a secret manager only; never commit this bearer.
MEMO_RELAYER_SIGNER_TOKEN=
MEMO_ENTRYPOINT_CODE_HASH=0x8db5ff695839d655407cc8490bb7a5d82337a86a6b39c3f0258aa6c3b582fc58
MEMO_MIN_ENTRYPOINT_DEPOSIT_WEI=100000000000000000
MEMO_MIN_BUNDLER_EXECUTOR_BALANCE_WEI=100000000000000000
MEMO_BUNDLER_EXECUTOR_ADDRESS=
MEMO_ALLOW_WALLET_ADD_CHAIN=false
MEMO_API_URL=https://agent-did.example.com

# This preprod release intentionally has only the phase-one SQLite/file adapters.
# MEMO_ENVIRONMENT=production fails closed until PostgreSQL/S3 adapters exist.

# Independent local Agent Skill (never point these at the old Skill state)
MEMO_AGENT_MAINNET_ENVIRONMENT=local
MEMO_AGENT_MAINNET_CHAIN_ID=985
MEMO_AGENT_MAINNET_API_URL=http://127.0.0.1:4273
MEMO_AGENT_MAINNET_API_ORIGINS=
MEMO_AGENT_MAINNET_HOME=.data/mainnet-skill
MEMO_AGENT_MAINNET_INSTALLATION_ID=replace-with-stable-installation-id
MEMO_AGENT_MAINNET_KEY_PROVIDER=auto
# Supply through a trusted secret channel only when OS Keyring is unavailable.
MEMO_AGENT_MAINNET_MASTER_KEY=
MEMO_AGENT_MAINNET_ALLOW_R2=0
MEMO_AGENT_MAINNET_ALLOW_R4_TEST=0
