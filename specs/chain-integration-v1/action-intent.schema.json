{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memo:agent-did:chain-integration:v1:action-intent",
  "title": "Agent DID immutable action intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "intentId", "deploymentId", "networkId", "actionType", "domain", "types", "message", "digest", "requiredSigners", "chainSnapshot", "createdAt"],
  "properties": {
    "schema": { "const": "memo.agent-chain-intent/1" },
    "intentId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
    "deploymentId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
    "networkId": { "type": "string", "pattern": "^eip155:[1-9][0-9]*$" },
    "actionType": {
      "enum": ["RegisterAgent", "UpdateProfile", "UpdateDocument", "SuspendAgent", "ResumeAgent", "RevokeAgent", "RevokeInstanceCredential", "ActivateRelationship", "RenewRelationship", "EndRelationship", "TransferRelationship"]
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "chainId", "verifyingContract"],
      "properties": {
        "name": { "enum": ["MEMO Agent DID Registry", "MEMO Agent DID Management"] },
        "version": { "const": "1" },
        "chainId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "verifyingContract": { "$ref": "#/$defs/address" }
      }
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "type": { "enum": ["address", "bytes32", "uint64", "uint256", "bool"] }
          }
        }
      }
    },
    "message": { "type": "object", "minProperties": 1 },
    "digest": { "$ref": "#/$defs/hash" },
    "requiredSigners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "address"],
        "properties": {
          "role": { "enum": ["agent", "manager", "oldManager", "newManager", "actor"] },
          "address": { "$ref": "#/$defs/address" }
        }
      }
    },
    "chainSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockNumber", "blockHash", "timestamp"],
      "properties": {
        "blockNumber": { "type": "integer", "minimum": 0 },
        "blockHash": { "$ref": "#/$defs/hash" },
        "timestamp": { "type": "integer", "minimum": 1 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
  }
}
