{
  "name": "@memo/agent-did-management-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "dev": "npm run build && node --enable-source-maps dist/apps/api/src/main.js",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/serve-static": "5.0.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
