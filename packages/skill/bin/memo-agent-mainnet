#!/usr/bin/env node
import("../dist/cli.js").catch((error) => {
  process.stdout.write(JSON.stringify({
    schema: "memo.agent-cli-result/2",
    ok: false,
    action: "bootstrap",
    requestId: null,
    operationId: null,
    data: null,
    warnings: [],
    error: { code: "CLI_BOOTSTRAP_FAILED", message: String(error?.message ?? error), retryable: false }
  }) + "\n");
  process.exitCode = 1;
});
